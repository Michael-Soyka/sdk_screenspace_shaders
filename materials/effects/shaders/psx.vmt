screenspace_general
{
	$pixshader    "psx_ps20"
	$vertexshader "psx_vs20"

	$basetexture ""
	$texture1    "_rt_FullFrameFB"
	$texture2    ""
	$texture3    ""
	
	$ignorez            1
	$vertexcolor        1
	$vertextransform    1
	
	$copyalpha                 1
	$alpha_blend_color_overlay 0
	$alpha_blend               0
	$linearwrite               0
	$linearread_basetexture    0
	$linearread_texture1       0
	$linearread_texture2       0
	$linearread_texture3       0

	$c0_x     0.0
	$c0_y     0.0
	$c0_z     0.0
	$c0_w     0.0
}